{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "respectGitignore": false,
  "env": {
    "DOTNET_SYSTEM_NET_DISABLEIPV6": "1",
    "DO_NOT_TRACK": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
		"CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1"
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "statusLine": {
    "type": "command",
    "command": "sh ~/.claude/statusline-command.sh"
  },
  "outputStyle": "Concise",
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "autoAllowBashIfSandboxed": false,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": [
        "localhost",
        "*.github.com",
        "*.githubusercontent.com",
        "*.nuget.org",
        "*.datadoghq.com",
        "*.us3.datadoghq.com",
        "api.us3.datadoghq.com",
        "nuget.pkg.github.com",
        "energy360-servicebus-test.servicebus.windows.net"
      ],
      "allowUnixSockets": [],
      "allowAllUnixSockets": false,
      "allowLocalBinding": true
    },
    "filesystem": {
      "allowWrite": [
        "~/Library/Application Support/dotnet/runfile",
        "~/.local/share/NuGet",
        "~/.claude",
        "~/Projects/Intech/dotfiles/config-extra/claude",
        "~/.agents"
      ],
      "denyWrite": [
        "~/Applications/"
      ],
      "denyRead": [
        "~/.aws",
        "~/.azure",
        "~/.ssh"
      ]
    },
    "enableWeakerNestedSandbox": false,
    "enableWeakerNetworkIsolation": true,
    "excludedCommands": [
      "docker *",
      "pgrep *"
    ]
  },
  "effortLevel": "high",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "editorMode": "vim",
  "autoCompactEnabled": true,
  "disableDeepLinkRegistration": "disable",
  "mcpServers": {
    "rider": {
      "url": "http://127.0.0.1:64482/stream",
      "type": "http"
    },
    "pycharm": {
      "url": "http://127.0.0.1:64343/stream",
      "type": "http"
    },
    "shortcut": {
      "type": "http",
      "url": "https://mcp.shortcut.com/mcp"
    }
  }
}
